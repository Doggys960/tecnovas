generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?   @db.Text
  role          Role      @default(VENTAS)
  accounts      Account[]
  sessions      Session[]
  logs          LogSistema[]
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
  @@map("verificationtokens")
}

enum Role {
  ADMIN
  VENTAS
  TECNICO
  LOGISTICA
  FACTURACION
  POSTVENTA
  JEFE_OPERACIONES
}

model Cliente {
  id_cliente           Int       @id @default(autoincrement())
  razon_social       String
  ruc                String?   @unique
  direccion          String?
  telefono           String?
  email              String?
  historial_crediticio String?   @db.Text
  estado             String    @default("activo")
  created_at         DateTime  @default(now())
  pedidos            Pedido[]
  @@map("clientes")
}

model Pedido {
  id_pedido       Int       @id @default(autoincrement())
  codigo          String    @unique
  id_cliente      Int
  tipo_servicio   String
  ubicacion       String
  detalles        String?   @db.Text
  estado          String    @default("pendiente")
  fecha_creacion  DateTime  @default(now()) @db.Date
  fecha_aprobacion DateTime? @db.Date
  id_vendedor     String?
  cliente         Cliente   @relation(fields: [id_cliente], references: [id_cliente])
  validaciones    ValidacionPedido[]
  ordenes         OrdenInstalacion[]
  reservas        ReservaStock[]
  seguimientos    SeguimientoPostventa[]
  @@map("pedidos")
}

model ValidacionPedido {
  id_validacion     Int      @id @default(autoincrement())
  id_pedido         Int
  tipo_validacion   String
  aprobado          Boolean?
  observaciones     String?  @db.Text
  fecha_validacion  DateTime @default(now())
  id_validador      String?
  pedido            Pedido   @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  @@map("validaciones_pedido")
}

model Tecnico {
  id_tecnico      Int      @id @default(autoincrement())
  nombre          String
  zona_asignada   String
  disponible      Boolean  @default(true)
  carga_trabajo   Int      @default(0)
  telefono        String?
  email           String?
  activo          Boolean  @default(true)
  ordenes         OrdenInstalacion[]
  @@map("tecnicos")
}

model OrdenInstalacion {
  id_orden         Int       @id @default(autoincrement())
  codigo           String    @unique
  id_pedido        Int
  id_tecnico       Int?
  fecha_programada DateTime  @db.Date
  fecha_real_inicio DateTime?
  fecha_real_fin   DateTime?
  estado           String    @default("programada")
  reporte_firmado_url String?
  notas_tecnico    String?   @db.Text
  pedido           Pedido    @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  tecnico          Tecnico?  @relation(fields: [id_tecnico], references: [id_tecnico], onDelete: SetNull)
  facturas         Factura[]
  @@map("ordenes_instalacion")
}

model Proveedor {
  id_proveedor  Int        @id @default(autoincrement())
  razon_social  String
  contacto      String?
  email         String?
  telefono      String?
  direccion     String?
  activo        Boolean    @default(true)
  productos     Producto[]
  solicitudes   SolicitudReposicion[]
  @@map("proveedores")
}

model Producto {
  id_producto   Int        @id @default(autoincrement())
  codigo_sku    String?    @unique
  nombre        String
  categoria   String
  descripcion   String?    @db.Text
  stock_actual  Int        @default(0)
  stock_minimo  Int        @default(5)
  precio_unitario Decimal? @db.Decimal(10,2)
  id_proveedor  Int?
  proveedor     Proveedor? @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: SetNull)
  reservas      ReservaStock[]
  solicitudes   SolicitudReposicion[]
  @@map("productos")
}

model ReservaStock {
  id_reserva    Int      @id @default(autoincrement())
  id_pedido     Int
  id_producto   Int
  cantidad      Int
  fecha_reserva DateTime @default(now())
  estado        String   @default("activa")
  pedido        Pedido   @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  producto      Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Restrict)
  @@map("reservas_stock")
}

model SolicitudReposicion {
  id_solicitud   Int       @id @default(autoincrement())
  id_producto    Int
  cantidad       Int
  id_proveedor   Int?
  estado         String    @default("pendiente")
  fecha_solicitud DateTime @default(now())
  fecha_recepcion DateTime? @db.Date
  producto       Producto  @relation(fields: [id_producto], references: [id_producto], onDelete: Restrict)
  proveedor      Proveedor? @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: SetNull)
  @@map("solicitudes_reposicion")
}

model Factura {
  id_factura      Int      @id @default(autoincrement())
  codigo          String   @unique
  id_orden        Int
  monto           Decimal  @db.Decimal(12,2)
  iva             Decimal  @default(0) @db.Decimal(12,2)
  total           Decimal  @db.Decimal(12,2)
  estado          String   @default("pendiente")
  fecha_emision   DateTime @default(now()) @db.Date
  fecha_vencimiento DateTime? @db.Date
  pdf_url         String?
  enviada_email   Boolean  @default(false)
  orden           OrdenInstalacion @relation(fields: [id_orden], references: [id_orden], onDelete: Restrict)
  registros       RegistroContable[]
  @@map("facturas")
}

model RegistroContable {
  id_registro      Int      @id @default(autoincrement())
  id_factura       Int
  tipo_movimiento  String
  monto            Decimal  @db.Decimal(12,2)
  descripcion      String?  @db.Text
  fecha_registro   DateTime @default(now())
  factura          Factura  @relation(fields: [id_factura], references: [id_factura], onDelete: Cascade)
  @@map("registros_contables")
}

model SeguimientoPostventa {
  id_seguimiento  Int      @id @default(autoincrement())
  id_pedido       Int
  fecha_contacto  DateTime? @db.Date
  satisfaccion    Int?
  observaciones   String?  @db.Text
  reclamo         Boolean  @default(false)
  tipo_contacto   String   @default("llamada")
  estado          String   @default("pendiente")
  id_agente       String?
  pedido          Pedido   @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  @@map("seguimiento_postventa")
}

model LogSistema {
  id_log      Int      @id @default(autoincrement())
  id_usuario  String?
  accion      String
  entidad     String?
  id_entidad  Int?
  detalle     String?  @db.Text
  ip_address  String?
  created_at  DateTime @default(now())
  usuario     User?    @relation(fields: [id_usuario], references: [id], onDelete: SetNull)
  @@map("logs_sistema")
}
